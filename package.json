{
    "name": "israeli-financial-overview",
    "private": true,
    "workspaces": [
        "shared",
        "server",
        "client",
        "desktop-electron"
    ],
    "scripts": {
        "postinstall": "node scripts/ensure-rollup-native.mjs && npx patch-package",
        "setup": "npm install && npm run build -w shared",
        "server": "npm run dev -w server",
        "client": "npm run dev -w client",
        "dev": "npx concurrently \"npm run server\" \"npm run client\"",
        "kill-port": "powershell ./scripts/kill-port.ps1",
        "start": "npm run dev",
        "guide:embed-telegram": "npx marked -o .tmp-telegram.html -i docs/TELEGRAM_BOT_GUIDE.md --gfm && npx marked -o .tmp-telegram-he.html -i client/public/guides/TELEGRAM_BOT_GUIDE.he.md --gfm && node scripts/inline-telegram-guide-into-guide.mjs",
        "windows:package": "powershell -ExecutionPolicy Bypass -File packaging/windows/package.ps1",
        "macos:package": "bash packaging/macos/package.sh",
        "electron:start": "npm run start -w desktop-electron",
        "electron:dist": "npm run dist -w desktop-electron",
        "windows:electron": "npm run windows:package && npm run electron:dist",
        "macos:electron": "npm run macos:package && npm run dist:mac -w desktop-electron",
        "release:patch": "node scripts/bump-version.mjs patch",
        "release:minor": "node scripts/bump-version.mjs minor",
        "release:major": "node scripts/bump-version.mjs major",
        "test:browser": "node scripts/run-browser-tests.mjs",
        "test:e2e": "playwright test",
        "test:e2e:headed": "playwright test --headed",
        "test:e2e:ui": "playwright test --ui",
        "test:report": "playwright show-report"
    },
    "engines": {
        "node": ">=20"
    },
    "devDependencies": {
        "@playwright/test": "^1.62.1",
        "concurrently": "^8.2.2",
        "patch-package": "^8.0.1"
    },
    "overrides": {
        "@rollup/plugin-terser": "1.0.0",
        "serialize-javascript": "7.0.5",
        "extract-zip": "2.0.1",
        "esbuild": "0.28.2"
    }
}
